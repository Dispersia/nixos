<domain type='kvm'>
  <name>windows-physical</name>
  <title>Windows (physical dual-boot install)</title>
  <description>Boots the bare-metal Windows installation from its own disk
    (@WINDOWS_DISK@) in place, via whole-disk raw passthrough. Windows' boot
    files live on the shared ESP of the NixOS disk, so the VM gets a virtual
    copy instead (@ESP_IMAGE@, built by `windows-vm setup`). Only start this
    while Windows is fully shut down (no fast startup / hibernation) and its
    volumes are not mounted on the host.</description>
  <memory unit='GiB'>16</memory>
  <currentMemory unit='GiB'>16</currentMemory>
  <vcpu placement='static'>12</vcpu>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
  </os>
  <features>
    <acpi/>
    <apic/>
    <hyperv mode='passthrough'/>
  </features>
  <cpu mode='host-passthrough' check='none' migratable='off'/>
  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>
  <devices>
    <!-- Virtual copy of the shared ESP (Windows' boot files). Attached as
         SATA/AHCI: driver-free for firmware and guest. -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='@ESP_IMAGE@'/>
      <target dev='sdb' bus='sata'/>
    </disk>
    <!-- The physical Windows disk, whole, as a raw block device. SATA/AHCI
         so Windows' inbox storahci driver boots it without extra drivers.
         (Could move to virtio after installing the guest tools.) -->
    <disk type='block' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='native'/>
      <source dev='@WINDOWS_DISK@'/>
      <target dev='sda' bus='sata'/>
    </disk>
    <!-- virtio-win drivers + guest tools, always attached. -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='@VIRTIO_WIN_ISO@'/>
      <target dev='sdc' bus='sata'/>
      <readonly/>
    </disk>
    <controller type='usb' model='qemu-xhci' ports='8'/>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>
    <input type='tablet' bus='usb'/>
    <interface type='network'>
      <source network='default'/>
      <model type='e1000e'/>
    </interface>
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>
    <graphics type='spice' autoport='yes'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>
    <audio id='1' type='spice'/>
    <sound model='ich9'>
      <audio id='1'/>
    </sound>
    <video>
      <model type='virtio' heads='1' primary='yes'/>
    </video>
    <redirdev bus='usb' type='spicevmc'/>
    <redirdev bus='usb' type='spicevmc'/>
    <memballoon model='virtio'/>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
  </devices>
</domain>
