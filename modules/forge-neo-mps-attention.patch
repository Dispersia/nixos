+# The MPS backend has no fused scaled_dot_product_attention: every call falls back
+# to the math implementation, which materialises the whole (b * heads, q_seq, kv_seq)
+# logits tensor at once. At 1024x1024 that is 8 GiB for a single SD1.5 self-attention
+# layer. Walking the query axis in blocks is mathematically identical but only ever
+# needs one block at a time.
+ATTENTION_WORKSPACE_BYTES = 1536 * 1024 * 1024
+MPS_MAX_ALLOCATION_ELEMENTS = 2**31 - 1
+
+
+def attention_query_chunk_count(b, heads, q_seq, kv_seq, element_size, mask):
+    """How many query blocks are needed to keep one attention matrix within budget."""
+    if mask is not None:
+        return 1  # a mask would have to be sliced along with the query; leave those alone
+
+    elems_per_query = b * heads * kv_seq
+    if elems_per_query <= 0:
+        return 1
+
+    # account fp32 even for fp16 inputs: the math backend upcasts internally,
+    # and count two buffers (logits plus the softmax result)
+    bytes_per_query = elems_per_query * max(element_size, 4) * 2
+    max_queries = max(1, ATTENTION_WORKSPACE_BYTES // bytes_per_query)
+    # MPS refuses a single allocation above 2**31 - 1 elements
+    max_queries = min(max_queries, max(1, MPS_MAX_ALLOCATION_ELEMENTS // elems_per_query))
+
+    if max_queries >= q_seq:
+        return 1
+
+    return math.ceil(q_seq / max_queries)
+
+
