+        chunks = attention_query_chunk_count(b, heads, q.shape[2], k.shape[2], q.element_size(), mask)
+
+    if chunks > 1:
+        out = torch.empty((b, heads, q.shape[2], dim_head), dtype=q.dtype, layout=q.layout, device=q.device)
+        chunk_size = math.ceil(q.shape[2] / chunks)
+        # Plain bmm rather than scaled_dot_product_attention: MPS has no fused SDPA, and
+        # its math fallback reserves a multi-gigabyte workspace per call (measured 5.8 GiB
+        # vs 2.8 GiB for bmm at the same block size, and ~3.6x slower per block).
+        q_flat = q.reshape(b * heads, q.shape[2], dim_head)
+        k_flat = k.reshape(b * heads, k.shape[2], dim_head).transpose(1, 2)
+        v_flat = v.reshape(b * heads, v.shape[2], dim_head)
+        out_flat = out.reshape(b * heads, q.shape[2], dim_head)
+        scale = sdpa_extra.get("scale") or dim_head**-0.5
+
+        for i in range(0, q.shape[2], chunk_size):
+            end = min(i + chunk_size, q.shape[2])
+            sim = torch.bmm(q_flat[:, i:end], k_flat) * scale
